<?xml version="1.0" encoding="utf-8"?>
<!-- Add / edit pop-up on My wishes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/wishDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/aandb_primay_text_color"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/wishDialogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/field_outline"
        android:gravity="top|start"
        android:hint="Type your wish"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxHeight="200dp"
        android:minHeight="110dp"
        android:padding="12dp"
        android:textColor="@color/aandb_primay_text_color"
        android:textColorHint="@color/aandb_muted_text_color"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wishDialogDelete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="@color/aandb_error_text" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wishDialogCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/aandb_primay_text_color"
            app:cornerRadius="24dp"
            app:strokeColor="@color/aandb_field_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wishDialogSave"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/colorAccent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
