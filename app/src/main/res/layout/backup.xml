<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".backup.Backup">

    <com.jetradarmobile.snowfall.SnowfallView
        android:id="@+id/snowFlakes"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:snowflakeAlphaMax="255"
        app:snowflakeAlphaMin="150"
        app:snowflakeAngleMax="5"
        app:snowflakeImage="@drawable/ic_snow_flakes"
        app:snowflakeSizeMax="32dp"
        app:snowflakeSizeMin="8dp"
        app:snowflakeSpeedMax="12"
        app:snowflakeSpeedMin="4"
        app:snowflakesAlreadyFalling="false"
        app:snowflakesFadingEnabled="true"
        app:snowflakesNum="250" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/aandb_toolbar_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/white"
        app:popupTheme="@style/AppTheme.PopupOverlay" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/adView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- signed in -->
            <LinearLayout
                android:id="@+id/signedInView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/accountHeading"
                    layout="@layout/settings_section" />

                <LinearLayout
                    android:id="@+id/accountGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_group_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/accountRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/accountInitial"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/backup_avatar_circle"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/accountEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/aandb_primay_text_color"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Tap to use another account"
                                android:textColor="@color/aandb_muted_text_color"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/signOut"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Sign out"
                            android:textColor="@color/aandb_soon_text_color"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <include
                    android:id="@+id/backupHeading"
                    layout="@layout/settings_section" />

                <LinearLayout
                    android:id="@+id/backupGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_group_bg"
                    android:divider="@drawable/settings_divider"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- status, not tappable: last backup time and how it compares with this phone -->
                    <LinearLayout
                        android:id="@+id/backupStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/backupStatusTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/aandb_primay_text_color"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:id="@+id/backupStatusDetailRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ProgressBar
                                android:id="@+id/backupStatusSpinner"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="6dp"
                                android:indeterminateTint="@color/aandb_soon_text_color"
                                android:visibility="gone" />

                            <View
                                android:id="@+id/backupStatusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/backup_status_dot"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/backupStatusDetail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/aandb_muted_text_color"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <include
                        android:id="@+id/backupNowRow"
                        layout="@layout/settings_row" />

                    <include
                        android:id="@+id/restoreRow"
                        layout="@layout/settings_row" />
                </LinearLayout>

                <include
                    android:id="@+id/autoSyncHeading"
                    layout="@layout/settings_section" />

                <include
                    android:id="@+id/autoSyncOptions"
                    layout="@layout/settings_group" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:text="Sends changes up, or brings missing birthdays down"
                    android:textColor="@color/aandb_muted_text_color"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- signed out -->
            <LinearLayout
                android:id="@+id/signedOutView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/settings_group_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/settings_icon_circle">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cloud_off"
                            app:tint="@color/aandb_soon_text_color" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Not backed up yet"
                        android:textColor="@color/aandb_primay_text_color"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Sign in with Google to keep your birthdays safe if you lose or change your phone."
                        android:textColor="@color/aandb_muted_text_color"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/signIn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="@color/colorAccent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:letterSpacing="0"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="Sign in with Google"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="24dp" />
                </LinearLayout>

                <include
                    android:id="@+id/fileHeading"
                    layout="@layout/settings_section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_group_bg"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/restoreFileRow"
                        layout="@layout/settings_row" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:text="Auto sync needs a Google account"
                    android:textColor="@color/aandb_muted_text_color"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- shown over the top of the page while backing up or restoring -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorAccent"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
        android:id="@+id/adView"
        android:layout_width="0dp"
        android:layout_height="50dp"
        ads:adSize="BANNER"
        ads:adUnitId="@string/ad_wishtemplate"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
