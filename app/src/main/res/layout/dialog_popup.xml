<?xml version="1.0" encoding="utf-8"?>
<!-- Shared pop-up shown by PopupDialog: "Already saved", "Delete Name?" and "Delete all" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/popupIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/today_cake_circle"
        android:padding="12dp"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/popupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/aandb_primay_text_color"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popupMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/aandb_muted_text_color"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/popupRowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/today_card_bg"
        android:backgroundTint="@color/aandb_dob_preview"
        android:visibility="gone">

        <include
            android:id="@+id/popupRow"
            layout="@layout/list_item_default" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popupSecondary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAllCaps="false"
            android:textColor="@color/aandb_primay_text_color"
            app:cornerRadius="24dp"
            app:strokeColor="@color/aandb_field_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popupPrimary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorAccent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
