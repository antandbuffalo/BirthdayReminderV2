<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/remindRadio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:saveEnabled="false"
        app:buttonTint="@color/remind_radio_tint" />

    <TextView
        android:id="@+id/remindLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/aandb_primay_text_color"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/remindHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/aandb_muted_text_color"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
