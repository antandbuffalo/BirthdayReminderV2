<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/aandb_error_text" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/aandb_today_accent_text" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/aandb_field_stroke" />
        </shape>
    </item>
</selector>
