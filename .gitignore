# Signing material — never commit. Losing the keystore means you can no
# longer publish updates to the existing Play listing, so keep a backup
# of it somewhere safe outside this repo.
*.jks
*.keystore
keystore.properties

# Android Studio files that are generated or tied to one machine. Shared
# settings (codeStyles, inspectionProfiles, encodings, vcs) stay tracked.
/.idea/gradle.xml
/.idea/misc.xml
/.idea/deploymentTargetDropDown.xml
/.idea/deploymentTargetSelector.xml
/.idea/compiler.xml
/.idea/jarRepositories.xml
/.idea/runConfigurations.xml
/.idea/AndroidProjectSystem.xml
